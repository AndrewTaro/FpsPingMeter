(def constant FPM_FONT_SIZE
	[
		13,	# Default
		15,	# Large
		17,	# Gigantic
	]
)

(def constant FPM_FONT_STYLE_MESSAGE
	[
		'$FPM_MessageDefaultStyle',	# Default/Dark
		'$FPM_MessageLightStyle',	# Light
	]
)

(def constant FPM_FONT_STYLE_VALUE
	[
		'$FPM_ValueDefalutStyle',	# Default/Dark
		'$FPM_ValueLightStyle',		# Light
	]
)

(def constant FPM_FONT_COLOR {
	CRITICAL		: 0xff4b1d,
	WARNING			: 0xffb600,
	THEME_DEFAULT	: 0xe5161616,
	THEME_LIGHT		: 0xFFFFFF,
})

(def css $FPM_MessageDefaultStyle()
	(extends $FontFamilyDefault)
	(extends $FontFpsDropShadowWhite)
	(extends $FontColorFPS)
	(extends $TextMouseDisable)
)

(def css $FPM_ValueDefalutStyle()
	(extends $FontFamilyDefaultBold)
	(extends $FontFpsDropShadowWhite)
	(extends $FontColorFPS)
	(extends $TextMouseDisable)
)

(def css $FPM_MessageLightStyle()
	(extends $FPM_MessageDefaultStyle)
	(extends $FontColorWhite)
	(extends $FontDropShadowFilter)
)

(def css $FPM_ValueLightStyle()
	(extends $FPM_ValueDefalutStyle)
	(extends $FontColorWhite)
	(extends $FontDropShadowFilter)
)


# The theme + size pair is read by all three display elements; folded so a silently-wrong key has one
# place to live.  Both are ordinals into the constant tables above, not values.
(def macro FPM_GET_FONT_PREFS ()
	(macro TT_GET_PREF _varName="'__fontStylePref'" _key="'fpsPingMeter.fontStyle'")
	(var __fontStyleValue:number = "null != __fontStylePref && null != __fontStylePref.value ? __fontStylePref.value : 0")
	(var fontStyleIndex:number = "__fontStyleValue < FPM_FONT_STYLE_MESSAGE.length ? __fontStyleValue : 0")

	(macro TT_GET_PREF _varName="'__fontSizePref'" _key="'fpsPingMeter.fontSize'")
	(var __fontSizeValue:number = "null != __fontSizePref && null != __fontSizePref.value ? __fontSizePref.value : 0")
	(var fontSizeIndex:number = "__fontSizeValue < FPM_FONT_SIZE.length ? __fontSizeValue : 0")

	(var messageFontStyle:str = "FPM_FONT_STYLE_MESSAGE[fontStyleIndex]")
	(var valueFontStyle:str = "FPM_FONT_STYLE_VALUE[fontStyleIndex]")
	(var fontSize:number = "FPM_FONT_SIZE[fontSizeIndex]")
)

(def element FpsDisplay(fps:number) layout=true
	# mod
	(scope
		(macro FPM_GET_FONT_PREFS)

		(macro TT_GET_PREF _varName="'warnPref'" _key="'fpsPingMeter.fpsWarnThreshold'")
		(var fpsWarnThreshold:number = "null != warnPref && null != warnPref.value ? warnPref.value : 55")
		(macro TT_GET_PREF _varName="'critPref'" _key="'fpsPingMeter.fpsCritThreshold'")
		(var fpsCritThreshold:number = "null != critPref && null != critPref.value ? critPref.value : 30")

		(var warningColor:number = "fps < fpsCritThreshold	? FPM_FONT_COLOR.CRITICAL :
									fps < fpsWarnThreshold	? FPM_FONT_COLOR.WARNING :
									fontStyleIndex == 0   	? FPM_FONT_COLOR.THEME_DEFAULT
															: FPM_FONT_COLOR.THEME_LIGHT
		"
		)
	)
	#

	(style
		(flow = "horizontal")
	)

	(tf
		# mod
		(bind class "valueFontStyle")
		#
		(bind text "fps")
		(style
			(bind minWidth "floor(fps/10) ? 18 : 12")
			(bind fontSize "fontSize")
			(bind textColor "warningColor")
			(filters 
				(dropShadow 
					(distance = 0)
					(angle = 90)
					(bind color "fps < fpsWarnThreshold ? 0x000000 : 0xFFFFFF")
					(alpha = 1.0)
					(blurX = 2.0)
					(blurY = 2.0)
					(strength = 0.6)
					(quality = 2)
				)
			)
		)
	)
	(tf
		# mod
		(bind class "messageFontStyle")
		(style
			(bind fontSize "fontSize")
		)
		#
		(text = 'FPS')
	)
)

(def element PingDisplay(ping:number) layout=true
	# mod
	(scope
		(macro FPM_GET_FONT_PREFS)

		(macro TT_GET_PREF _varName="'warnPref'" _key="'fpsPingMeter.pingWarnThreshold'")
		(var pingWarnThreshold:number = "null != warnPref && null != warnPref.value ? warnPref.value : 100")
		(macro TT_GET_PREF _varName="'critPref'" _key="'fpsPingMeter.pingCritThreshold'")
		(var pingCritThreshold:number = "null != critPref && null != critPref.value ? critPref.value : 150")
		(var warningColor:number = "ping > pingCritThreshold	? FPM_FONT_COLOR.CRITICAL :
									ping > pingWarnThreshold	? FPM_FONT_COLOR.WARNING :
									fontStyleIndex == 0 		? FPM_FONT_COLOR.THEME_DEFAULT
																: FPM_FONT_COLOR.THEME_LIGHT
		"
		)
	)
	#
	(bind visible "ping > 0")
	(style
		(flow = "horizontal")
	)

	(tf
		# mod
		(bind class "messageFontStyle")
		(style
			(bind fontSize "fontSize")
		)
		#
		(text = 'ping')
	)
	(tf
		# mod
		(bind class "valueFontStyle")
		#
		(style
			(bind minWidth "floor(ping/100) ? 24 : 18")
			(bind textColor "warningColor")
			(bind fontSize "fontSize")
			(filters 
				(dropShadow 
					(distance = 0)
					(angle = 90)
					(bind color "ping > pingWarnThreshold ? 0x000000 : 0xFFFFFF")
					(alpha = 1.0)
					(blurX = 2.0)
					(blurY = 2.0)
					(strength = 0.6)
					(quality = 2)
				)
			)
		)
		(bind text "ping")
	)
	(tf
		# mod
		(bind class "messageFontStyle")
		(style
			(bind fontSize "fontSize")
		)
		#
		(text = 'ms')
	)
)

(def element FpsPanel() layout=true
	(scope
		(macro GET_PREF 'showPerformance' "'ui.showPerformance'")

		(var performance:gfx="$datahub.getSingleEntity(CC.performanceInfo).performanceInfo")
		(var fps:number = "performance.fps" (event "performance.evChanged"))
		(var ping:number = "performance.ping" (event "performance.evChanged"))
		(var replayFps:number = "performance.replayFps" (event "performance.evChanged"))
		(var replayPing:number = "performance.replayPing" (event "performance.evChanged"))

		# Mod
		(macro FPM_GET_FONT_PREFS)
		#
	)

	(bindcall externalCall 'direct.action' "['option.set', ['ui.showPerformance', true]]" init=false watch=false on='addedToStage')

	(bind visible "showPerformance")

	(style
		(position = "absolute")
		(paddingTop = 2)
		(paddingLeft = 3)
	)

	(hblock
		(element FpsDisplay "fps")
		(element PingDisplay "ping")
	)

	(hblock
		(bind visible "replayFps > 0 || replayPing > 0")
		(tf
			(bind class "messageFontStyle")
			(style
				(bind fontSize "fontSize")
			)
			(text = 'Recorded')
		)

		(element FpsDisplay "replayFps")
		(element PingDisplay "replayPing")
	)
)